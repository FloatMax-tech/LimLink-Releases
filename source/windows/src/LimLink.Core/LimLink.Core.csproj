<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net10.0;net10.0-windows10.0.22000.0</TargetFrameworks>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <RootNamespace>LimLink</RootNamespace>
    <AssemblyName>LimLink.Core</AssemblyName>
    <Description>UI-less LimLink node (identity, mTLS, hello) for later WinUI and MAUI hosts.</Description>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="LimLink.Core.Tests" />
  </ItemGroup>
</Project>
