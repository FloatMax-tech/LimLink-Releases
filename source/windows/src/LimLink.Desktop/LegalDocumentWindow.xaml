<Window x:Class="LimLink.Desktop.LegalDocumentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:LimLink.Desktop"
        Width="640" Height="620" MinWidth="400" MinHeight="320"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        FontFamily="{StaticResource UiFont}" FontSize="13" Foreground="{DynamicResource Ink}"
        Background="{DynamicResource LayerSolid}" UseLayoutRounding="True">
  <Window.Resources>
    <Style x:Key="SectionHeading" TargetType="TextBlock">
      <Setter Property="FontSize" Value="15" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="Margin" Value="0,22,0,7" />
    </Style>
    <Style x:Key="SectionBody" TargetType="TextBlock">
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="LineHeight" Value="22" />
    </Style>
  </Window.Resources>
  <Grid KeyboardNavigation.TabNavigation="Cycle">
    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
    <Border BorderBrush="{DynamicResource Stroke}" BorderThickness="0,0,0,1" Padding="20">
      <DockPanel>
        <Button DockPanel.Dock="Right" Style="{StaticResource WinButton}" Content="{loc:Loc close}"
                IsCancel="True" Margin="16,0,0,0" />
        <TextBlock Text="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}"
                   FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center" />
      </DockPanel>
    </Border>
    <ScrollViewer x:Name="DocumentScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled" Focusable="True"
                  AutomationProperties.Name="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}">
      <StackPanel Margin="20,16,20,24">
        <TextBlock Text="{loc:Loc legal_updated}" Foreground="{DynamicResource Sub}" TextWrapping="Wrap" />
        <TextBlock Text="{loc:Loc legal_operator}" Foreground="{DynamicResource Sub}" TextWrapping="Wrap" Margin="0,6,0,0" />
        <TextBlock Text="{loc:Loc legal_developer}" Foreground="{DynamicResource Sub}" TextWrapping="Wrap" Margin="0,6,0,0" />
        <StackPanel x:Name="PrivacyContent">
          <TextBlock Text="{loc:Loc legal_local_title}" Style="{StaticResource SectionHeading}" />
          <TextBlock Text="{loc:Loc legal_local_body}" Style="{StaticResource SectionBody}" />
          <TextBlock Text="{loc:Loc legal_discovery_title}" Style="{StaticResource SectionHeading}" />
          <TextBlock Text="{loc:Loc legal_discovery_body}" Style="{StaticResource SectionBody}" />
          <TextBlock Text="{loc:Loc legal_binding_title}" Style="{StaticResource SectionHeading}" />
          <TextBlock Text="{loc:Loc legal_binding_body}" Style="{StaticResource SectionBody}" />
          <TextBlock Text="{loc:Loc legal_storage_title}" Style="{StaticResource SectionHeading}" />
          <TextBlock Text="{loc:Loc legal_storage_body}" Style="{StaticResource SectionBody}" />
          <TextBlock Text="{loc:Loc legal_preview_storage}" Style="{StaticResource SectionBody}" Margin="0,8,0,0" />
          <TextBlock Text="{loc:Loc legal_notifications_title}" Style="{StaticResource SectionHeading}" />
          <TextBlock Text="{loc:Loc legal_notifications_body}" Style="{StaticResource SectionBody}" />
          <TextBlock Text="{loc:Loc updates_check}" Style="{StaticResource SectionHeading}" />
          <TextBlock Text="{loc:Loc updates_disclosure}" Style="{StaticResource SectionBody}" />
        </StackPanel>
        <StackPanel x:Name="UsageContent">
          <TextBlock Text="{loc:Loc usage_about_title}" Style="{StaticResource SectionHeading}" />
          <TextBlock Text="{loc:Loc usage_about_body}" Style="{StaticResource SectionBody}" />
          <TextBlock Text="{loc:Loc usage_sharing_title}" Style="{StaticResource SectionHeading}" />
          <TextBlock Text="{loc:Loc usage_sharing_body}" Style="{StaticResource SectionBody}" />
          <TextBlock Text="{loc:Loc usage_transfer_title}" Style="{StaticResource SectionHeading}" />
          <TextBlock Text="{loc:Loc usage_transfer_body}" Style="{StaticResource SectionBody}" />
          <TextBlock Text="{loc:Loc usage_privacy_title}" Style="{StaticResource SectionHeading}" />
          <TextBlock Text="{loc:Loc usage_privacy_body}" Style="{StaticResource SectionBody}" />
          <TextBlock Text="{loc:Loc usage_excerpt_notice}" Foreground="{DynamicResource Sub}" TextWrapping="Wrap" Margin="0,22,0,0" />
          <TextBlock Text="{loc:Loc usage_liability_title}" Style="{StaticResource SectionHeading}" />
          <TextBlock Text="{loc:Loc usage_liability_body}" Style="{StaticResource SectionBody}" />
          <TextBlock Text="{loc:Loc usage_disclaimer_title}" Style="{StaticResource SectionHeading}" />
          <TextBlock Text="{loc:Loc usage_disclaimer_body}" Style="{StaticResource SectionBody}" />
        </StackPanel>
        <TextBlock Text="{loc:Loc legal_support_title}" Style="{StaticResource SectionHeading}" />
        <TextBlock Text="{loc:Loc legal_support_body}" Style="{StaticResource SectionBody}" />
        <TextBox Text="limlink@floatmax-tech.com" IsReadOnly="True" BorderThickness="0" Padding="0"
                 Background="Transparent" Foreground="{DynamicResource Ink}" Margin="0,10,0,0"
                 AutomationProperties.Name="limlink@floatmax-tech.com" />
        <Button x:Name="OnlineDocumentButton" Click="OpenOnlineDocument" Style="{StaticResource WinButton}"
                HorizontalAlignment="Left" HorizontalContentAlignment="Left" Margin="0,14,0,0" MaxWidth="520">
          <Button.ContentTemplate><DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" /></DataTemplate></Button.ContentTemplate>
        </Button>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</Window>
