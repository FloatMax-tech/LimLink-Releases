    "收到的文件未能保存，请检查本机剩余空间后重新发送。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "收到的文件未能保存，请检查本机剩余空间后重新发送。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The received file could not be saved. Check the available storage on this device, then send it again."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "收到的檔案無法儲存，請檢查本機剩餘空間後重新傳送。"
