    "设备名称不能为空。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设备名称不能为空。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The device name can’t be empty."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "裝置名稱不能留空。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デバイス名を入力してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기기 이름은 비워 둘 수 없습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le nom de l’appareil ne peut pas être vide."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Gerätename darf nicht leer sein."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El nombre del dispositivo no puede estar vacío."
          }
        },
        "it": {
