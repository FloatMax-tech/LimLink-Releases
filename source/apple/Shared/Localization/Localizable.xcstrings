          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La versión del otro dispositivo aún requiere enlazarse. Actualiza ambos dispositivos a la última versión."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La versione sull’altro dispositivo richiede ancora l’abbinamento. Aggiorna entrambi i dispositivi all’ultima versione."
          }
        }
      }
    },
