        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "받은 파일을 저장하지 못했습니다. 이 기기의 여유 공간을 확인한 후 다시 보내세요."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
