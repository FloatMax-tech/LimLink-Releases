    "局域网还没准备好。请确认已连接 Wi-Fi，然后重试。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "局域网还没准备好。请确认已连接局域网（Wi-Fi 或网线），然后重试。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The local network is not ready yet. Make sure Wi-Fi is connected, then try again."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "區域網路尚未就緒。請確認已連接區域網路，然後再試一次。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ローカルネットワークの準備ができていません。Wi-Fiに接続していることを確認して、もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "로컬 네트워크가 아직 준비되지 않았습니다. Wi-Fi 연결을 확인한 후 다시 시도하세요."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le réseau local n’est pas encore prêt. Vérifiez la connexion Wi-Fi, puis réessayez."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das lokale Netzwerk ist noch nicht bereit. Prüfe die WLAN-Verbindung und versuche es erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La red local aún no está lista. Comprueba la conexión Wi-Fi e inténtalo de nuevo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La rete locale non è ancora pronta. Verifica la connessione Wi-Fi e riprova."
          }
        }
      }
    },
    "局域网连接失败": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "局域网连接失败"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Local network connection failed"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "區域網路連線失敗"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ローカルネットワークへの接続に失敗しました"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "로컬 네트워크 연결 실패"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Échec de la connexion au réseau local"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verbindung zum lokalen Netzwerk fehlgeschlagen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Error al conectar con la red local"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Connessione alla rete locale non riuscita"
          }
        }
      }
    },
    "局域网连接失败。请检查本地网络权限，让双方保持 LimLink 在前台后重试。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "局域网连接失败。请检查本地网络权限，让双方保持 LimLink 在前台后重试。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Local network connection failed. Check local network permissions, keep LimLink in the foreground on both devices, and try again."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "區域網路連線失敗。請檢查本機網路權限，讓雙方保持 LimLink 在前景後再試一次。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ローカルネットワークへの接続に失敗しました。ローカルネットワークへのアクセス権限を確認し、両方のデバイスでLimLinkを前面に表示してから、もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "로컬 네트워크 연결에 실패했습니다. 로컬 네트워크 권한을 확인하고 두 기기 모두 LimLink를 화면에 띄운 상태에서 다시 시도하세요."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La connexion au réseau local a échoué. Vérifiez les autorisations du réseau local, gardez LimLink au premier plan sur les deux appareils et réessayez."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Verbindung zum lokalen Netzwerk ist fehlgeschlagen. Prüfe die Berechtigungen für das lokale Netzwerk, lasse LimLink auf beiden Geräten im Vordergrund und versuche es erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ha podido conectar con la red local. Revisa los permisos de red local, mantén LimLink en primer plano en ambos dispositivos e inténtalo de nuevo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Connessione alla rete locale non riuscita. Verifica le autorizzazioni della rete locale, tieni LimLink in primo piano su entrambi i dispositivi e riprova."
          }
        }
      }
    },
