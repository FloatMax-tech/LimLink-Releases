    "通过 Apple 一次性付款，可重复支持，无需订阅。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通过 Apple 一次性付款，可重复支持，无需订阅。"
