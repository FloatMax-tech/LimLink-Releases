    "设备名称不能包含换行或控制字符。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设备名称不能包含换行或控制字符。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The device name can’t contain line breaks or control characters."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "裝置名稱不能包含換行或控制字元。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デバイス名に改行や制御文字は使用できません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기기 이름에 줄 바꿈이나 제어 문자를 사용할 수 없습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le nom de l’appareil ne peut pas contenir de sauts de ligne ni de caractères de contrôle."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Gerätename darf keine Zeilenumbrüche oder Steuerzeichen enthalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El nombre del dispositivo no puede contener saltos de línea ni caracteres de control."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il nome del dispositivo non può contenere interruzioni di riga o caratteri di controllo."
          }
        }
      }
    },
    "设备名称太长，请缩短后重试。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设备名称太长，请缩短后重试。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The device name is too long. Shorten it and try again."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "裝置名稱過長，請縮短後再試。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デバイス名が長すぎます。短くしてからやり直してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기기 이름이 너무 깁니다. 줄인 후 다시 시도해 주세요."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le nom de l’appareil est trop long. Raccourcissez-le et réessayez."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Gerätename ist zu lang. Bitte kürzen und erneut versuchen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El nombre del dispositivo es demasiado largo. Acórtalo e inténtalo de nuevo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il nome del dispositivo è troppo lungo. Accorcialo e riprova."
          }
        }
      }
    },
    "设备连接信息已变化，请刷新附近设备后重试。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设备连接信息已变化，请刷新附近设备后重试。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The device’s connection details have changed. Refresh nearby devices and try again."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "裝置連線資訊已變更，請重新整理附近裝置後再試。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デバイスの接続情報が変更されました。近くのデバイスを更新してからやり直してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기기의 연결 정보가 변경되었습니다. 주변 기기 목록을 새로 고친 후 다시 시도해 주세요."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les informations de connexion de l’appareil ont changé. Actualisez les appareils à proximité et réessayez."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Verbindungsdaten des Geräts haben sich geändert. Geräte in der Nähe aktualisieren und erneut versuchen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los datos de conexión del dispositivo han cambiado. Actualiza los dispositivos cercanos e inténtalo de nuevo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le informazioni di connessione del dispositivo sono cambiate. Aggiorna i dispositivi vicini e riprova."
          }
        }
      }
    },
    "请保持 LimLink 在前台，直到完成": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请保持 LimLink 在前台，直到完成"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep LimLink in the foreground until it finishes"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請保持 LimLink 在前景執行，直到完成"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "完了するまで LimLink を前面に表示してください"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "완료될 때까지 LimLink를 화면에 열어 두세요"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gardez LimLink au premier plan jusqu’à la fin"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "LimLink bis zum Abschluss im Vordergrund lassen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén LimLink en primer plano hasta que termine"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantieni LimLink in primo piano fino al termine"
          }
        }
      }
    },
    "请允许 LimLink 使用本地网络：打开「设置 › 隐私与安全性 › 本地网络」并打开 LimLink，然后重试。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请允许 LimLink 使用本地网络：打开「设置 › 隐私与安全性 › 本地网络」并打开 LimLink，然后重试。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow LimLink to use the local network: open Settings › Privacy & Security › Local Network, enable LimLink, then try again."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請允許 LimLink 使用區域網路：開啟「設定 › 隱私權與安全性 › 區域網路」並開啟 LimLink，然後再試。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "LimLink にローカルネットワークへのアクセスを許可してください。「設定 › プライバシーとセキュリティ › ローカルネットワーク」で LimLink をオンにしてからやり直してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "LimLink의 로컬 네트워크 접근을 허용해 주세요. ‘설정 › 개인정보 보호 및 보안 › 로컬 네트워크’를 열고 LimLink를 켠 후 다시 시도해 주세요."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autorisez LimLink à utiliser le réseau local : ouvrez Réglages › Confidentialité et sécurité › Réseau local, activez LimLink, puis réessayez."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "LimLink den Zugriff auf das lokale Netzwerk erlauben: „Einstellungen › Datenschutz & Sicherheit › Lokales Netzwerk“ öffnen, LimLink aktivieren und erneut versuchen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite que LimLink use la red local: abre Ajustes › Privacidad y seguridad › Red local, activa LimLink e inténtalo de nuevo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Consenti a LimLink di usare la rete locale: apri Impostazioni › Privacy e sicurezza › Rete locale, attiva LimLink e riprova."
          }
        }
      }
    },
    "请在另一台设备上打开 LimLink\n连接同一 Wi-Fi，并允许本地网络访问": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在另一台设备上打开 LimLink\n连接同一局域网（Wi-Fi 或网线），并允许本地网络访问"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open LimLink on another device\nConnect to the same local network (Wi-Fi or Ethernet) and allow local network access"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請在另一台裝置上開啟 LimLink\n連接同一個 Wi-Fi，並允許區域網路存取"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "別のデバイスで LimLink を開いてください\n同じ Wi-Fi に接続し、ローカルネットワークへのアクセスを許可してください"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 기기에서 LimLink를 열어 주세요\n같은 Wi-Fi에 연결하고 로컬 네트워크 접근을 허용하세요"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrez LimLink sur un autre appareil\nConnectez-le au même Wi-Fi et autorisez l’accès au réseau local"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "LimLink auf einem anderen Gerät öffnen\nMit demselben lokalen Netzwerk (WLAN oder Ethernet) verbinden und Zugriff auf das lokale Netzwerk erlauben"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre LimLink en otro dispositivo\nConéctalo a la misma red local (Wi-Fi o Ethernet) y permite el acceso a la red local"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
