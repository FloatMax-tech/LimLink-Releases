    "网络未连接或正在切换。请连接 Wi-Fi 后重试。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "网络未连接或正在切换。请连接局域网（Wi-Fi 或网线） 后重试。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The network is disconnected or changing. Connect to Wi-Fi and try again."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "網路未連線或正在切換。請連接區域網路 後再試。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ネットワークが未接続か、切り替え中です。Wi-Fi に接続してからやり直してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "네트워크가 연결되지 않았거나 전환 중입니다. Wi-Fi에 연결한 후 다시 시도해 주세요."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le réseau est déconnecté ou en cours de changement. Connectez-vous au Wi-Fi et réessayez."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Netzwerk ist getrennt oder wird gerade gewechselt. Mit WLAN verbinden und erneut versuchen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La red está desconectada o cambiando. Conéctate al Wi-Fi e inténtalo de nuevo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La rete è disconnessa o in fase di cambio. Connettiti al Wi-Fi e riprova."
          }
        }
      }
    },
    "网络端口被其他程序占用，请稍后重试。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "网络端口被其他程序占用，请稍后重试。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The network port is in use by another app. Please try again later."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "網路連接埠正被其他程式使用，請稍後再試。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ネットワークポートがほかのアプリで使用されています。しばらくしてからやり直してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 앱이 네트워크 포트를 사용 중입니다. 나중에 다시 시도해 주세요."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le port réseau est utilisé par une autre app. Veuillez réessayer plus tard."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Netzwerkport wird von einer anderen App verwendet. Bitte später erneut versuchen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Otra app está usando el puerto de red. Inténtalo de nuevo más tarde."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La porta di rete è in uso da un’altra app. Riprova più tardi."
          }
        }
      }
    },
