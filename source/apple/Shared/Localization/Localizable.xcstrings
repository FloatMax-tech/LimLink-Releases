        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffne die Fotos-App des Systems, um empfangene Bilder anzusehen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre la app Fotos del sistema para ver las imágenes recibidas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apri l’app Foto di sistema per vedere le immagini ricevute."
          }
        }
      }
    },
    "自动将收到的图片存入相册": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自动将收到的图片存入相册"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatically save received images to Photos"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "自動將收到的圖片存入相簿"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "受信した画像を写真に自動保存"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "받은 이미지를 갤러리에 자동 저장"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistrer automatiquement les images reçues dans Photos"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Empfangene Bilder automatisch in Fotos sichern"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guardar automáticamente las imágenes recibidas en Fotos"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Salva automaticamente le immagini ricevute in Foto"
          }
        }
      }
    },
    "需要系统相册授权；接收目录中的原文件会保留。相册副本由系统相册管理。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "需要系统相册授权；接收目录中的原文件会保留。相册副本由系统相册管理。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Requires system Photos permission. Originals stay in the receive folder. Manage photo copies in Photos."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "需要系統相簿授權；接收資料夾中的原檔會保留。相簿副本由系統相簿管理。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "システムの写真への追加許可が必要です。受信フォルダの元ファイルは保持され、写真のコピーは写真アプリで管理します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시스템 갤러리 권한이 필요합니다. 원본은 수신 폴더에 유지되며 갤러리 복사본은 시스템 갤러리에서 관리합니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’autorisation Photos est nécessaire. Les originaux restent dans le dossier de réception. Gérez les copies dans Photos."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erfordert die Fotos-Berechtigung. Originale bleiben im Empfangsordner. Fotokopien werden in Fotos verwaltet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Requiere permiso de Fotos. Los originales se conservan en la carpeta de recepción. Gestiona las copias desde Fotos."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Richiede l’autorizzazione Foto. Gli originali restano nella cartella di ricezione. Gestisci le copie in Foto."
          }
        }
      }
    },
    "文件预览与相册": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "文件预览与相册"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "File previews and Photos"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "檔案預覽與相簿"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ファイルプレビューと写真"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "파일 미리보기 및 갤러리"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperçus de fichiers et Photos"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dateivorschau und Fotos"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vistas previas y Fotos"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Anteprime e Foto"
          }
        }
      }
    },
    "文件预览在本机完成，不需要上传文件。图片自动存入相册时，仅请求系统添加权限，不读取整个相册；相册可能按系统设置同步。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "文件预览在本机完成，不需要上传文件。图片自动存入相册时，仅请求系统添加权限，不读取整个相册；相册可能按系统设置同步。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "File previews run on your device without uploading files. Automatic photo saving requests add-only permission and does not read your whole library. Photos may sync according to your system settings."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "檔案預覽在本機完成，不需上傳檔案。圖片自動存入相簿時，僅請求系統新增權限，不讀取整個相簿；相簿可能依系統設定同步。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プレビューはファイルをアップロードせず端末内で行います。画像の自動保存には追加のみの権限を使い、写真ライブラリ全体を読み取りません。写真はシステム設定に従って同期される場合があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "파일을 업로드하지 않고 기기에서 미리 봅니다. 사진 자동 저장은 추가 전용 권한만 요청하며 전체 갤러리를 읽지 않습니다. 사진은 시스템 설정에 따라 동기화될 수 있습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les aperçus sont locaux, sans téléversement. L’enregistrement automatique demande seulement l’ajout à Photos, sans lire toute la photothèque. Photos peut synchroniser les images selon vos réglages système."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dateivorschauen erfolgen lokal ohne Upload. Automatisches Sichern verlangt nur die Berechtigung zum Hinzufügen und liest nicht die ganze Mediathek. Fotos kann gemäß Systemeinstellungen synchronisieren."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las vistas previas son locales, sin subir archivos. El guardado automático solicita solo permiso para añadir fotos y no lee toda la biblioteca. Fotos puede sincronizarse según los ajustes del sistema."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le anteprime sono locali, senza caricamenti. Il salvataggio automatico richiede solo il permesso di aggiungere foto e non legge tutta la libreria. Foto può sincronizzarsi secondo le impostazioni di sistema."
          }
        }
      }
    },
    "接收目录与相册保留各自副本。删除接收记录不会删除相册副本，可在本机身份中关闭自动保存。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "接收目录与相册保留各自副本。删除接收记录不会删除相册副本，可在本机身份中关闭自动保存。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The receive folder and Photos keep separate copies. Removing a received-file entry does not remove the Photos copy. Disable automatic saving in device settings."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "接收資料夾與相簿各自保留副本。刪除接收記錄不會刪除相簿副本，可在本機身分中關閉自動儲存。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "受信フォルダと写真には別々のコピーが残ります。受信履歴を削除しても写真のコピーは削除されません。本機情報で自動保存をオフにできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "수신 폴더와 갤러리는 별도의 사본을 보관합니다. 수신 기록을 삭제해도 갤러리 사본은 삭제되지 않습니다. 기기 설정에서 자동 저장을 끌 수 있습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le dossier de réception et Photos conservent des copies distinctes. Supprimer une entrée reçue ne supprime pas la copie Photos. Désactivez l’enregistrement automatique dans les réglages de l’appareil."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Empfangsordner und Fotos behalten getrennte Kopien. Das Entfernen eines Empfangseintrags löscht keine Fotokopie. Automatisches Sichern lässt sich in den Geräteeinstellungen ausschalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La carpeta de recepción y Fotos mantienen copias separadas. Eliminar un registro no elimina la copia de Fotos. Puedes desactivar el guardado automático en los ajustes del dispositivo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La cartella di ricezione e Foto mantengono copie separate. Eliminare una voce non rimuove la copia in Foto. Puoi disattivare il salvataggio automatico nelle impostazioni del dispositivo."
          }
        }
      }
    },
