          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ha podido guardar el archivo recibido. Comprueba el espacio disponible en este dispositivo y envíalo de nuevo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile salvare il file ricevuto. Controlla lo spazio disponibile su questo dispositivo e invialo di nuovo."
          }
        }
      }
