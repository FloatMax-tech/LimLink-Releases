          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "상대 기기의 버전은 아직 페어링이 필요합니다. 두 기기를 모두 최신 버전으로 업데이트하세요."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La version de l’autre appareil nécessite encore un jumelage. Mettez les deux appareils à jour vers la dernière version."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
