    "共享空间不可用。请使用「发送给附近设备」，或在 LimLink 中选择文件。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "共享空间不可用。请使用「发送给附近设备」，或在 LimLink 中选择文件。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The shared container is unavailable. Use “Send to nearby devices”, or choose a file in LimLink."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "共享空間無法使用。請使用「傳送給附近裝置」，或在 LimLink 中選擇檔案。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "共有領域を利用できません。「近くのデバイスに送信」を使うか、LimLink でファイルを選択してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "공유 공간을 사용할 수 없습니다. “근처 기기에 보내기”를 사용하거나 LimLink에서 파일을 선택해 주세요."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’espace partagé n’est pas disponible. Utilisez « Envoyer aux appareils à proximité » ou choisissez un fichier dans LimLink."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der gemeinsame Speicher ist nicht verfügbar. Verwende „An Geräte in der Nähe senden“ oder wähle eine Datei in LimLink aus."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El espacio compartido no está disponible. Usa «Enviar a dispositivos cercanos» o elige un archivo en LimLink."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo spazio condiviso non è disponibile. Usa “Invia ai dispositivi vicini” o scegli un file in LimLink."
          }
        }
      }
    },
