    "名称已保存，局域网暂未就绪，请返回首页重试。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "名称已保存，局域网暂未就绪，请返回首页重试。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Name saved. The local network is not ready yet. Return to the home screen and try again."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "名稱已儲存，區域網路尚未就緒，請返回首頁再試一次。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "名前を保存しました。ローカルネットワークの準備ができていません。ホームに戻ってもう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이름을 저장했습니다. 로컬 네트워크가 아직 준비되지 않았습니다. 홈 화면으로 돌아가 다시 시도하세요."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nom enregistré. Le réseau local n’est pas encore prêt. Revenez à l’accueil et réessayez."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Name gespeichert. Das lokale Netzwerk ist noch nicht bereit. Kehre zur Startseite zurück und versuche es erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nombre guardado. La red local aún no está lista. Vuelve al inicio e inténtalo de nuevo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nome salvato. La rete locale non è ancora pronta. Torna alla schermata iniziale e riprova."
          }
        }
      }
    },
    "名称由对方设备自行设置。接收后不会自动打开。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "名称由对方设备自行设置。接收后不会自动打开。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The name is set by the other device. The file will not open automatically after receiving."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "名稱由對方裝置自行設定。接收後不會自動開啟。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "名前は相手のデバイスが設定しています。受信後にファイルが自動で開くことはありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이름은 상대 기기에서 설정합니다. 파일은 받은 후 자동으로 열리지 않습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le nom est défini par l’autre appareil. Le fichier ne s’ouvrira pas automatiquement après réception."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Name wird vom anderen Gerät festgelegt. Die Datei wird nach dem Empfang nicht automatisch geöffnet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El nombre lo establece el otro dispositivo. El archivo no se abrirá automáticamente al recibirlo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il nome è impostato dall’altro dispositivo. Il file non si aprirà automaticamente dopo la ricezione."
          }
        }
      }
    },
    "向左拖动或右键可移到废纸篓": {
