          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기기 간 전송"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Transferts entre appareils"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Übertragung zwischen Geräten"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Transferencias entre dispositivos"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Trasferimenti tra dispositivi"
          }
        }
      }
    },
    "为发现和连接附近设备，LimLink 会在同一局域网内交换设备名称、设备类型、连接地址和加密身份标识。你确认接收后，文件通过加密连接直接传给对方。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "为发现和连接附近设备，LimLink 会在同一局域网内交换设备名称、设备类型、连接地址和加密身份标识。你确认接收后，文件通过加密连接直接传给对方。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To discover and connect to nearby devices, LimLink exchanges device names, device types, connection addresses, and cryptographic identity identifiers on the same local network. After you confirm receipt, files are sent directly to the other device over an encrypted connection."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "為探索和連接附近裝置，LimLink 會在同一區域網路內交換裝置名稱、裝置類型、連線位址和加密身分識別碼。你確認接收後，檔案會透過加密連線直接傳給對方。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "近くのデバイスの検出と接続のため、LimLink は同じローカルネットワーク内でデバイス名、デバイスの種類、接続アドレス、暗号化に用いる識別情報を交換します。受信を承認すると、ファイルは暗号化された接続で相手のデバイスに直接送信されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "주변 기기를 검색하고 연결하기 위해 LimLink는 같은 로컬 네트워크에서 기기 이름, 기기 유형, 연결 주소 및 암호화 ID 식별자를 교환합니다. 수신을 승인하면 암호화된 연결을 통해 파일이 상대 기기로 직접 전송됩니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour découvrir les appareils à proximité et s’y connecter, LimLink échange les noms et types d’appareils, les adresses de connexion et les identifiants d’identité cryptographique sur le même réseau local. Après confirmation de la réception, les fichiers sont envoyés directement à l’autre appareil via une connexion chiffrée."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Um Geräte in der Nähe zu finden und sich mit ihnen zu verbinden, tauscht LimLink Gerätenamen, Gerätetypen, Verbindungsadressen und kryptografische Identitätskennungen im selben lokalen Netzwerk aus. Nach deiner Empfangsbestätigung werden Dateien über eine verschlüsselte Verbindung direkt an das andere Gerät gesendet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para descubrir dispositivos cercanos y conectarse a ellos, LimLink intercambia nombres y tipos de dispositivos, direcciones de conexión e identificadores de identidad criptográfica en la misma red local. Tras confirmar la recepción, los archivos se envían directamente al otro dispositivo mediante una conexión cifrada."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per rilevare i dispositivi vicini e connettersi, LimLink scambia nomi e tipi di dispositivi, indirizzi di connessione e identificatori di identità crittografica sulla stessa rete locale. Dopo la conferma della ricezione, i file vengono inviati direttamente all’altro dispositivo tramite una connessione cifrata."
          }
        }
      }
    },
    "分享与保存": {
      "extractionState": "manual",
      "localizations": {
