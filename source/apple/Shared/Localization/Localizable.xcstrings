    "可在系统设置中允许添加照片，然后重试。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可在系统设置中允许添加照片，然后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "可在系統設定中允許加入照片，然後重試。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow adding photos in system settings, then try again."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "システム設定で写真の追加を許可してから、もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시스템 설정에서 사진 추가를 허용한 후 다시 시도하세요."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autorisez l’ajout de photos dans les réglages système, puis réessayez."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erlaube das Hinzufügen von Fotos in den Systemeinstellungen und versuche es erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite añadir fotos en los ajustes del sistema y vuelve a intentarlo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Consenti l’aggiunta di foto nelle impostazioni di sistema, quindi riprova."
          }
        }
      }
    },
    "仅在点击时向官网查询版本信息，不上传文件、设备名称或绑定记录。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅在点击时向官网查询版本信息，不上传文件、设备名称或绑定记录。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "僅在點擊時向官網查詢版本資訊，不上傳檔案、裝置名稱或綁定記錄。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Checks the official website only when you tap. Files, device names and bindings are not uploaded."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ボタンを押したときだけ公式サイトで更新を確認します。ファイル、端末名、ペアリング情報は送信しません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "버튼을 누를 때만 공식 사이트에서 업데이트를 확인합니다. 파일, 기기 이름, 연결 기록은 전송하지 않습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérifie le site officiel uniquement sur demande. Aucun fichier, nom d’appareil ou association n’est envoyé."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Prüft die offizielle Website nur auf Knopfdruck. Dateien, Gerätenamen und Kopplungen werden nicht hochgeladen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Consulta el sitio oficial solo al pulsar el botón. No se envían archivos, nombres de dispositivos ni vinculaciones."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Controlla il sito ufficiale solo su richiesta. File, nomi dei dispositivi e associazioni non vengono caricati."
          }
        }
      }
    }
  },
  "version": "1.0"
}
