            "value": "对方版本仍需要配对，请将两台设备更新到最新版。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The other device’s version still requires pairing. Update both devices to the latest version."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "對方的版本仍需要配對，請將兩台裝置更新到最新版本。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
