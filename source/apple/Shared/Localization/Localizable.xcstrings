    "打开 LimLink 会自动选中这个文件，选择设备即可发送。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开 LimLink 会自动选中这个文件，选择设备即可发送。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Opening LimLink will automatically select this file. Choose a device to send it."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開啟 LimLink 後會自動選取這個檔案，選擇裝置即可傳送。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "LimLinkを開くと、このファイルが自動で選択されます。デバイスを選んで送信してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "LimLink를 열면 이 파일이 자동으로 선택됩니다. 보낼 기기를 선택하세요."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce fichier sera automatiquement sélectionné à l’ouverture de LimLink. Choisissez un appareil pour l’envoyer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beim Öffnen von LimLink wird diese Datei automatisch ausgewählt. Wähle zum Senden ein Gerät aus."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al abrir LimLink, este archivo se seleccionará automáticamente. Elige un dispositivo para enviarlo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aprendo LimLink, questo file verrà selezionato automaticamente. Scegli un dispositivo per inviarlo."
          }
        }
      }
    },
