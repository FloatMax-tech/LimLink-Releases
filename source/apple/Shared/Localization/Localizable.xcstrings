    "连接就绪后会显示附近设备": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "连接就绪后会显示附近设备"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nearby devices will appear once the connection is ready"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "連線就緒後將顯示附近裝置"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "接続の準備ができると、近くのデバイスが表示されます"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "연결이 준비되면 주변 기기가 표시됩니다"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les appareils à proximité apparaîtront une fois la connexion prête"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Geräte in der Nähe werden angezeigt, sobald die Verbindung bereit ist"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
