    "你选择的文件、接收记录、设备名称和偏好保存在设备上。LimLink 不要求注册账号，也不包含广告或分析追踪。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你选择的文件、接收记录、设备名称和偏好保存在设备上。LimLink 不要求注册账号，也不包含广告或分析追踪。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your selected files, receive history, device name, and preferences are stored on your device. LimLink does not require an account and does not include advertising or analytics tracking."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你選擇的檔案、接收記錄、裝置名稱和偏好設定儲存在裝置上。LimLink 不要求註冊帳號，也不包含廣告或分析追蹤。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択したファイル、受信履歴、デバイス名、設定はデバイス上に保存されます。LimLink はアカウント登録を必要とせず、広告や分析のための追跡も含みません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택한 파일, 수신 기록, 기기 이름 및 환경설정은 기기에 저장됩니다. LimLink는 계정 등록이 필요하지 않으며 광고나 분석 추적을 포함하지 않습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les fichiers sélectionnés, l’historique de réception, le nom de l’appareil et vos préférences sont stockés sur votre appareil. LimLink ne nécessite pas de compte et ne contient ni publicité ni suivi analytique."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine ausgewählten Dateien, der Empfangsverlauf, der Gerätename und deine Einstellungen werden auf deinem Gerät gespeichert. LimLink erfordert kein Konto und enthält weder Werbung noch Analyse-Tracking."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los archivos seleccionados, el historial de recepción, el nombre del dispositivo y tus preferencias se guardan en tu dispositivo. LimLink no requiere una cuenta ni incluye publicidad o seguimiento analítico."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I file selezionati, la cronologia di ricezione, il nome del dispositivo e le preferenze vengono memorizzati sul dispositivo. LimLink non richiede un account e non include pubblicità o tracciamento analitico."
          }
        }
      }
    },
    "设备之间的传输": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设备之间的传输"
          }
        },
        "en": {
