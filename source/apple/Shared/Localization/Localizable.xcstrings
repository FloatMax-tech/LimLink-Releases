          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permisos y notificaciones"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Autorizzazioni e notifiche"
          }
        }
      }
    },
    "本地网络和通知权限可在系统设置中更改。通知可能显示设备和文件名称；你可以在系统通知设置中控制预览。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本地网络和通知权限可在系统设置中更改。通知可能显示设备和文件名称；你可以在系统通知设置中控制预览。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can change local network and notification permissions in system settings. Notifications may show device and file names; you can control previews in the system’s notification settings."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "區域網路和通知權限可在系統設定中更改。通知可能顯示裝置和檔案名稱；你可以在系統通知設定中控制預覽。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ローカルネットワークと通知のアクセス許可は、システム設定で変更できます。通知にデバイス名やファイル名が表示される場合があります。プレビューの表示は、システムの通知設定で変更できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "로컬 네트워크 및 알림 권한은 시스템 설정에서 변경할 수 있습니다. 알림에 기기 및 파일 이름이 표시될 수 있으며, 시스템 알림 설정에서 미리보기를 제어할 수 있습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous pouvez modifier les autorisations de réseau local et de notifications dans les réglages système. Les notifications peuvent afficher les noms d’appareils et de fichiers ; vous pouvez contrôler les aperçus dans les réglages de notifications du système."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Berechtigungen für das lokale Netzwerk und Mitteilungen lassen sich in den Systemeinstellungen ändern. Mitteilungen können Geräte- und Dateinamen anzeigen; die Vorschau können Sie in den Mitteilungseinstellungen des Systems steuern."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puedes cambiar los permisos de red local y notificaciones en los ajustes del sistema. Las notificaciones pueden mostrar nombres de dispositivos y archivos; puedes controlar las previsualizaciones en los ajustes de notificaciones del sistema."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Puoi modificare le autorizzazioni per la rete locale e le notifiche nelle impostazioni di sistema. Le notifiche potrebbero mostrare i nomi dei dispositivi e dei file; puoi controllare le anteprime nelle impostazioni delle notifiche di sistema."
          }
        }
      }
    },
    "在线页面与支持": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在线页面与支持"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Online Pages and Support"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "線上頁面與支援"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オンラインページとサポート"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "온라인 페이지 및 지원"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pages en ligne et assistance"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Onlineseiten und Support"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Páginas en línea y soporte"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Pagine online e assistenza"
          }
        }
      }
    },
    "在线政策与支持页面按需在外部浏览器打开，适用相应网站的隐私规则。联系支持时，请勿提交文件内容、密钥或私人日志。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在线政策与支持页面按需在外部浏览器打开，适用相应网站的隐私规则。联系支持时，请勿提交文件内容、密钥或私人日志。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Online policy and support pages open in an external browser when requested and are subject to the privacy rules of the respective website. When contacting support, do not submit file contents, keys, or private logs."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "線上政策與支援頁面依需要在外部瀏覽器開啟，適用相應網站的隱私規則。聯絡支援時，請勿提交檔案內容、金鑰或私人記錄。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オンラインのポリシーやサポートのページは、必要に応じて外部ブラウザで開き、各ウェブサイトのプライバシールールが適用されます。サポートへのお問い合わせ時に、ファイルの内容、鍵、プライベートなログを送信しないでください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "온라인 정책 및 지원 페이지는 요청 시 외부 브라우저에서 열리며, 해당 웹사이트의 개인정보 보호 규칙이 적용됩니다. 지원 문의 시 파일 내용, 키 또는 비공개 로그를 제출하지 마세요."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les pages de politique et d’assistance en ligne s’ouvrent à la demande dans un navigateur externe et sont soumises aux règles de confidentialité du site concerné. Lorsque vous contactez l’assistance, ne transmettez pas de contenu de fichiers, de clés ni de journaux privés."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Online-Richtlinien und Supportseiten werden bei Bedarf in einem externen Browser geöffnet. Es gelten die Datenschutzregeln der jeweiligen Website. Übermitteln Sie bei Supportanfragen keine Dateiinhalte, Schlüssel oder privaten Protokolle."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las páginas de políticas y soporte en línea se abren en un navegador externo cuando se solicitan y están sujetas a las normas de privacidad del sitio correspondiente. Al contactar con soporte, no envíes contenido de archivos, claves ni registros privados."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le pagine online delle politiche e dell’assistenza si aprono su richiesta in un browser esterno e sono soggette alle regole sulla privacy del rispettivo sito. Quando contatti l’assistenza, non inviare contenuti dei file, chiavi o registri privati."
          }
        }
      }
    },
